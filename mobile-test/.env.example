# Copy this file to .env and fill in real values before running `npm start`.
# Both variables are prefixed EXPO_PUBLIC_ because Expo inlines them into the
# app bundle: they must never be SUPABASE_SERVICE_ROLE_KEY, DEEPSEEK_API_KEY,
# or any other server-side secret. Only the app-level ABFINI_API_KEY (the
# one the ABFINI API itself checks on /v1/chat) belongs here.

# HTTPS URL of the deployed ABFINI API (same backend the Web client proxies to).
EXPO_PUBLIC_ABFINI_API_URL=https://your-abfini-api.example.com

# Must match ABFINI_API_KEY configured on the ABFINI API.
EXPO_PUBLIC_ABFINI_API_KEY=replace-with-the-abfini-api-key
